# 9to5 AI — copy to .env.local (dashboard) and GitHub Actions secrets (agent)

# Required — all modes
NEXT_PUBLIC_MOCK_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
AGENT_SECRET=change-me-min-8-chars

# Supabase (required for live mode only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Agent user UUID (live Supabase persistence)
AGENT_USER_ID=

# Gemini (live mode, when AI enabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free backup AI, used when Gemini's daily quota runs out (optional, either or both).
# Also turns on per-job resume tailoring (rewording bullets) without spending Gemini.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Resume tailoring: ai | free | off (default: ai when a backup key is set, else free)
RESUME_TAILOR=

# Gmail OAuth (live mode, when email scanning enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

# Encrypted password storage (disabled by default)
ENCRYPTION_KEY=
MASTER_PASSWORD_HASH=

# GitHub Actions — keep LIVE_AGENT_ENABLED unset until ready
LIVE_AGENT_ENABLED=

# Legacy aliases (optional)
MOCK_MODE=true
AGENT_CRON_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
